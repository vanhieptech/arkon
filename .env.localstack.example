# ============================================================
# Arkon POC — LocalStack (S3) + Amazon Bedrock (LLM + embedding)
# cp .env.localstack.example .env.docker
# ============================================================

# --- LocalStack (https://app.localstack.cloud/) ---
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_DEBUG=0

# --- AWS (Bedrock — real AWS account; enable models in console) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- S3 via LocalStack (merged by docker-compose.localstack.yml) ---
MINIO_ENDPOINT=localstack:4566
MINIO_PUBLIC_ENDPOINT=localhost:4566
MINIO_ACCESS_KEY=test
MINIO_SECRET_KEY=test
MINIO_BUCKET=arkon-files
MINIO_SECURE=false
MINIO_REGION=us-east-1

# --- Postgres / Redis (unchanged from .env.docker.example) ---
POSTGRES_USER=arkon
POSTGRES_PASSWORD=arkon_secret
POSTGRES_DB=arkon
DATABASE_URL=postgresql+asyncpg://arkon:arkon_secret@postgres:5432/arkon

SECRET_KEY=change-me
MCP_TOKEN_PEPPER=change-me
DEFAULT_ADMIN_EMAIL=admin@arkon.local
DEFAULT_ADMIN_PASSWORD=admin123

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=arkon_secret
REDIS_DB=0

CORS_ORIGINS=*
NEXT_PUBLIC_API_URL=http://localhost:5055

# --- POC auto-config: set active LLM/embedding to Bedrock after migrate ---
POC_CONFIGURE_BEDROCK=1
POC_LLM_SPEC_ID=bedrock/claude-3-5-sonnet
POC_EMBEDDING_SPEC_ID=bedrock/titan-embed-v2
